# القناة العامة الرسمية المصدر
SOURCE_CHANNEL_USERNAME=IssaAllaith

# بيانات Telegram Client API (من https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_STRING_SESSION=your_generated_string_session_here

# بيانات قناة الأرشيف الخاصة بك والبوت المشرف فيها
TELEGRAM_BOT_TOKEN=123456789:ABC_your_bot_token_here
TELEGRAM_ARCHIVE_CHANNEL_ID=-1001234567890

# وضع التخزين: telegram (مجاني 100%) أو r2
STORAGE_MODE=telegram

# إعدادات Cloudflare D1 REST API
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_d1_api_token
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_uuid

# وضع التشغيل: incremental (دوري) أو backfill (أرشفة تاريخية أولية)
SYNC_MODE=incremental
SYNC_BATCH_LIMIT=50

