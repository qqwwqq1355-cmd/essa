{
  "name": "@essa/edge-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute essa-alleth-db --local --file=../../database/migrations/0001_initial_schema.sql",
    "db:migrate:remote": "wrangler d1 execute essa-alleth-db --remote --file=../../database/migrations/0001_initial_schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}

